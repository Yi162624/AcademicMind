# 复制此文件为 .env 并填入真实 key（.env 已被 gitignore，不会上传）

# 文本模型：DeepSeek（所有文本 Agent 共用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_MAX_CONTEXT=64000
DEEPSEEK_TIMEOUT=120

# 视觉模型：Qwen3-VL-Plus（图片/图表理解）
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_VL_MAX_TOKENS=4096
QWEN_VL_MAX_CONTEXT=32768
QWEN_VL_TIMEOUT=120

# 预算（元）
DAILY_BUDGET=20
MONTHLY_BUDGET=200

# 数据目录
DATA_DIR=data
CACHE_DIR=data/cache

# 论文检索数据源开关（比赛合规用）
# domestic     = 比赛版：不调用境外 API（arXiv/OpenAlex 全短路）；
#                调研检索改走境内"阿里云百炼 Qwen 联网搜索"（enable_search，请求发国内节点、数据不出境），
#                单篇精读只支持本地上传 PDF；全程零境外请求
# international = 完整版：可联网调 arXiv/OpenAlex 搜索、下载论文、Docling 走官方源（比赛后改回这个）
RESEARCH_SOURCE=domestic

# 境内联网搜索配置（比赛合规版调研模式用，key 默认复用上面 QWEN_VL 的百炼 key，可单独指定）
#QWEN_SEARCH_API_KEY=
#QWEN_SEARCH_MODEL=qwen-plus
#QWEN_SEARCH_TIMEOUT=90

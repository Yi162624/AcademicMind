# 复制此文件为 .env 并填入真实 key（.env 已被 gitignore，不会上传）

# 文本模型：DeepSeek-V4-Pro（所有文本 Agent 共用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_MAX_CONTEXT=64000
DEEPSEEK_TIMEOUT=120

# 视觉模型：Qwen2.5-VL-7B（图片/图表理解）
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen2.5-vl-7b-instruct
QWEN_VL_MAX_TOKENS=4096
QWEN_VL_MAX_CONTEXT=32768
QWEN_VL_TIMEOUT=120

# 预算（元）
DAILY_BUDGET=20
MONTHLY_BUDGET=200

# 数据目录
DATA_DIR=data
CACHE_DIR=data/cache
